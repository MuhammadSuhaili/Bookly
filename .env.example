# --- Database ---
# PostgreSQL connection string (hosted/remote or local):
#   postgres://user:password@host:port/database
DATABASE_URL=

# --- Authentication ---
# Random secret used to sign session cookies (e.g. `openssl rand -base64 32`)
AUTH_SECRET=

# --- App ---
# Public base URL of your app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment: development | production
APP_ENV=development
